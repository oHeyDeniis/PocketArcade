<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E3A8A"
    android:fillViewport="true"
    tools:context=".SecretGameActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtSecretDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• • • •"
            android:textColor="#93C5FD"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Digite quatro números diferentes"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Campo de Entrada -->
        <EditText
            android:id="@+id/edtCodeInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:hint="Ex: 1234"
            android:inputType="number"
            android:maxLength="4"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFEDD5"
            android:text="Tentar"
            android:textColor="#9A3412"
            android:textStyle="bold"
            app:cornerRadius="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#3B82F6" />

        <TextView
            android:id="@+id/txtAttemptsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentativas: 0/8"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Contêiner do Histórico de Tentativas -->
        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- Card Animado de Conclusão da Partida -->
        <LinearLayout
            android:id="@+id/conclusionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#2563EB"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/txtConclusionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Vitória!" />

            <TextView
                android:id="@+id/txtConclusionDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#DBEAFE"
                android:textSize="15sp"
                tools:text="Você acertou em 4 tentativas e 12 segundos!" />

            <Button
                android:id="@+id/btnNewGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FFEDD5"
                android:text="Nova partida"
                android:textColor="#9A3412"
                android:textStyle="bold"
                app:cornerRadius="4dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>